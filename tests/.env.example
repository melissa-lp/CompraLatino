# Gateway 
BASE_URL=http://localhost:3000

# Servicios, para las pruebas que los consultan directamente
IDENTITY_URL=http://localhost:3001
CATALOG_URL=http://localhost:3002
ORDERS_URL=http://localhost:3003
RECOMMENDATIONS_URL=http://localhost:3004
YAUCTIONS_URL=http://localhost:3006

# Origen permitido por CORS 
FRONTEND_URL=http://localhost:5173

# OPCIONAL: el mismo JWT_SECRET del gateway. Habilita la prueba de token expirado.
JWT_SECRET=

# OPCIONAL: cuenta con rol admin 
ADMIN_EMAIL=
ADMIN_PASSWORD=

# 1 para no crear órdenes reales (omite las pruebas de compra)
QA_SKIP_PURCHASE=0

# 1 para ejecutar POST /admin/catalog/sync (sincroniza el catálogo con el mock)
QA_RUN_SYNC=0
