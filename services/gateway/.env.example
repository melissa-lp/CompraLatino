# Variables de entorno del API Gateway

# --- Autenticación ---
# Debe ser el mismo JWT_SECRET que usa identity, para poder verificar los tokens
JWT_SECRET=

# --- Direcciones de los servicios (desarrollo local) ---
IDENTITY_URL=http://localhost:3001
CATALOG_URL=http://localhost:3002
ORDERS_URL=http://localhost:3003
RECOMMENDATIONS_URL=http://localhost:3004
ADMIN_URL=http://localhost:3005

# --- Servidor ---
PORT=3000
