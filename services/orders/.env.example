# Variables de entorno del servicio de Compras

# --- Base de datos (Supabase / PostgreSQL) ---
DATABASE_URL=

# --- API de YAuctions (simulada por el servicio yauctions-mock) ---
YAUCTIONS_API_URL=http://localhost:3006

# --- Otros servicios ---
CATALOG_URL=http://localhost:3002
RECOMMENDATIONS_URL=

# --- Precios ---
# Dólares por 1 yen (1 USD ≈ 150 JPY → 0.0067)
EXCHANGE_RATE_USD_PER_JPY=0.0067
# Cargo por servicio de CompraLatino, por orden
SERVICE_FEE_USD=5.00

# --- Servidor ---
PORT=3003
