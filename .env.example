# Plantilla de variables de entorno de CompraLatino

# --- Base de datos (Supabase / PostgreSQL) ---
# Database > Connection string
DATABASE_URL=

# --- Supabase (Storage de imágenes) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Clave con permisos totales: solo para uso en el backend
SUPABASE_SERVICE_ROLE_KEY=

# --- Autenticación (servicio de Identidad) ---
JWT_SECRET=
JWT_EXPIRES_IN=1h

# --- Puertos de cada servicio ---
GATEWAY_PORT=3000
IDENTITY_PORT=3001
CATALOG_PORT=3002
ORDERS_PORT=3003
RECOMMENDATIONS_PORT=3004
ADMIN_PORT=3005
